<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New user</title>
</head>
<body>
    <h2>Create a new user here</h2>
    <form method="POST" action="/user/new">
        <input type="text" placeholder="enter your username" name="username"> <br><br>
        <input type="email" placeholder="enter your email" name="email"> <br><br>
        <input type="password" placeholder="enter your password" name="password"> <br><br>
        <button>Create</button>
    </form>
</body>
</html>