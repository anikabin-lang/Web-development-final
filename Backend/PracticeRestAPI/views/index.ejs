<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Tweets</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Twitter</h1>
    <% for(tweet of tweets){ %>
        <div class="tweet">
            <h3 class="username">@<%=tweet.username%></h3>
            <h4 class="content"><%=tweet.content%></h4>
            <a href="http://localhost:8080/tweets/<%=tweet.id%>">View Tweet in Detail</a>
            <a href="http://localhost:8080/tweets/<%=tweet.id%>/edit">Edit Tweet</a> <br><br>
            <form method="post" action="/tweets/<%=tweet.id%>?_method=DELETE">
                <button>Delete tweet</button>
            </form>
        </div>
    <% } %>
    <br><br>
    <a href="http://localhost:8080/tweets/new">Post a new Tweet</a>
</body>
</html>