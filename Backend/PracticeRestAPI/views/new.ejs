<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Tweet</title>
</head>
<body>
    <h2>Post a New Tweet</h2>
    <form action="/tweets/new" method="POST">
        <input type="text" name="username" placeholder="enter your username"> <br><br>
        <textarea name="content" rows="10" cols="20" placeholder="write your tweet"></textarea> <br><br>
        <button>Submit Tweet</button>
    </form>
</body>
</html>