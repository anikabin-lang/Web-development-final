<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View tweet in Detail</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>Tweet in Detail</h2>
    <p>Tweet id: <%=tweet.id%></p>
    <div class="tweet">
        <h3 class="username">username: @<%=tweet.username%></h3>
        <h4 class="content"><%=tweet.content%></h4>
    </div>
</body>
</html>