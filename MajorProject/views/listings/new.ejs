<%layout("/layouts/boilerplate")%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Create a New Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation">
                <div class="mb-3" >
                    <lable for="title" class="form-label">Title</lable>
                    <input type="text" name="listing[title]" placeholder="add a catchy title" class="form-control" required> 
                    <div class="valid-feedback">Title looks good!</div>
                    <div class="invalid-feedback">Title should be valid</div>
                </div>
                <div class="mb-3" >
                    <lable for="description" class="form-label">Description</lable>
                    <textarea required name="listing[description]" class="form-control"></textarea>
                    <div class="invalid-feedback">Please enter a short description</div>
                </div>
                <div class="mb-3" >
                    <lable for="image" class="form-label">Image Link</lable>
                    <input type="text" name="listing[image]" placeholder="enter image URL/Link" class="form-control">
                </div>
                <div class="row">
                    <div class="mb-3 col-4 md-4">
                        <lable for="price" class="form-label">Price</lable>
                        <input required class="form-control" name="listing[price]" placeholder="1200"> 
                        <div class="invalid-feedback">Price should be valid</div>
                    </div>
                    <div class="mb-3 col-8 md-8">
                        <lable for="country" class="form-label">Country</lable>
                        <input required type="text" name="listing[country]" placeholder="India" class="form-control"> 
                        <div class="invalid-feedback">Country name should be valid</div>
                    </div>
                </div>
                <div class="mb-3" >
                    <lable for="location" class="form-label">Location</lable>
                    <input required type="text" name="listing[location]" placeholder="Jaipur,Rajasthan" class="form-control">
                    <div class="invalid-feedback">Location should be valid</div>
                </div>
                <button class="btn btn-dark add-btn mt-3">Add</button>
            </form>
        </div>
    </div>
</body>
